# difference_service configuration (SPECIFICATION.md §9). Copy to .env and adjust.
# Never commit .env — it is gitignored; this template holds PLACEHOLDERS ONLY.
#
# Shared cross-service keys keep the FILEENGINE_* prefix (one login, one event
# bus); service-private keys use DIFF_*.

# --- gRPC core (SHARED) ---
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# --- This service's worker principal (§2) ---
# Used ONLY by the event-driven precompute worker, which reads version content and
# writes diff renditions. On-demand requests run as the CALLING USER instead, so
# core ACLs gate them directly. Not system_admin: grant it rights on the files it
# must diff. Falls back to the shared FILEENGINE_LDAP_USER/PASSWORD if unset.
FILEENGINE_DIFF_TENANT=default
FILEENGINE_DIFF_USER=
FILEENGINE_DIFF_PASSWORD=

# --- LDAP (SHARED) ---
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:1389
FILEENGINE_LDAP_DOMAIN=dc=rationalboxes,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=rationalboxes,dc=com
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_PASSWORD=change-me-ldap
# Optional read replica for HA; the breaker fails over on an unreachable master.
FILEENGINE_LDAP_ENDPOINT_REPLICA=
DIFF_FAILOVER_COOLDOWN_S=30

# --- HTTP surface (loopback by default; the container overrides to 0.0.0.0) ---
DIFF_HTTP_HOST=127.0.0.1
DIFF_HTTP_PORT=8100
# DIFF_CORS_ORIGINS=https://app.example.com
# Restrict the unauthenticated /healthz /readyz /poolz to these IPs.
# FILEENGINE_MONITORING_ALLOW_IPS=127.0.0.1,::1
# Reverse-proxy CIDRs whose X-Forwarded-For is credible (client-IP resolution).
# FILEENGINE_TRUSTED_PROXIES=127.0.0.0/8

# --- Auth: accept http_bridge bearer tokens (SHARED secret for local HS256 verify) ---
FILEENGINE_JWT_SECRET=
# DIFF_BRIDGE_URL=http://localhost:8090
DIFF_TOKEN_TTL=3600
DIFF_PERMISSION_CACHE_TTL=300

# --- Events: consume the shared recognized stream with a private group (§2.1) ---
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=change-me-redis
FILEENGINE_REDIS_DB=0
FILEENGINE_EVENTS_STREAM=fileengine:events
DIFF_EVENTS_GROUP=difference_service
DIFF_CONSUMER_NAME=worker-1

# --- Worker / plugin tuning ---
DIFF_WORKER_CONCURRENCY=2
# Restrict which registered plugins are active (comma-separated); empty = all.
# DIFF_ENABLED_PLUGINS=pdf,3d
# Ceiling on ONE version's content, both sides of a pair. A larger pair degrades
# rather than exhausting the worker.
DIFF_MAX_SOURCE_BYTES=268435456
# Wall-clock budget for a single diff run before it degrades a tier / fails.
DIFF_TIMEOUT_S=600

# --- External tool paths (§9). Resolved lazily by the plugins that need them;
#     an absent tool degrades a tier, never fails the file. ---
DIFF_POPPLER_PATH=
DIFF_CONVERT2XKT_PATH=convert2xkt
